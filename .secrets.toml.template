# Argus — Secrets Template
# Copy this file to .secrets.toml and fill in your values.
# NEVER commit .secrets.toml to version control.
# This template lists key names and what they are for; it contains no values.

[openai]
# Direct OpenAI access (api.openai.com). Only this key is needed for the model.
key = ""   # OpenAI API key
# Do NOT set api_type, api_base, api_version or deployment_id here. Any of them
# switches LiteLLM to an Azure/other endpoint and breaks the openai/responses route.

[github]
# GitHub App credentials (webhook mode)
app_id = ""          # GitHub App ID (numeric)
webhook_secret = ""  # random string used to verify webhook payloads
# The App's private key, the full text of the downloaded .pem file including the
# BEGIN/END lines. Write it as a TOML multi-line string between triple quotes.
private_key = ""

# Polling mode only: a personal access token instead of the GitHub App.
user_token = ""
